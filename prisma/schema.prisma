// Property management MVP — data model
//
// Money is stored everywhere as integer cents (never floats).
// Every tenant-facing and staff-facing query is scoped by organizationId;
// see src/lib/rbac.ts for the guards that enforce it.

generator client {
  provider   = "prisma-client-js"
  // No embedded engine binary/WASM at all — everything goes through a driver
  // adapter (see src/lib/db.ts and prisma/seed.ts: @prisma/adapter-d1 in
  // production, @prisma/adapter-better-sqlite3 locally), so PrismaClient must
  // always be constructed with an `adapter`. Without this, the default
  // "library" engine bundles a ~2.2MB WASM query engine we never use.
  engineType = "client"
}

// SQLite dialect — this is what Cloudflare D1 actually is under the hood.
// Production runs on a real D1 binding (no connection string, no network hop
// to manage, no connection pool to go stale — see docs/MAINTAINER.md for why
// this replaced an external Postgres+Hyperdrive setup). `url` here is only
// used by the Prisma CLI (migrate/studio) against a local file; the app
// itself always goes through an explicit adapter at runtime, which ignores
// this value entirely — same pattern as before, just a different file.
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  ADMIN // full control of the organization, including billing + team
  STAFF // day-to-day property management, no team/billing control
  OWNER // read-only financial visibility into assigned properties
  TENANT // scoped to their own lease(s) only
}

enum UnitStatus {
  VACANT
  OCCUPIED
  MAINTENANCE
}

enum LeaseStatus {
  DRAFT
  ACTIVE
  ENDED
}

enum ChargeType {
  RENT
  LATE_FEE
  DEPOSIT
  OTHER
}

enum PaymentStatus {
  PENDING // created, awaiting tenant action
  PROCESSING // ACH in flight (can take 3-5 business days)
  SUCCEEDED
  FAILED
  REFUNDED
}

enum PaymentMethod {
  ACH
  CARD
  MANUAL // recorded by staff: cash, check, external transfer
}

// Where a payment actually came from. This is the primary axis for
// reconciliation — `PaymentMethod` above is a narrower, Stripe-specific detail
// (ACH vs card) that only ever applies to STRIPE_NATIVE payments now.
enum PaymentSource {
  MANUAL_CASH // cash, check, or anything hand-recorded with no statement to import
  IMPORT_BANK // bank/ACH statement CSV, uploaded by hand
  IMPORT_VENMO
  IMPORT_CASHAPP
  IMPORT_HAP // housing authority / Section 8 subsidy payment report
  STRIPE_NATIVE // collected in-app via Stripe Connect
  IMPORT_PLAID // pulled automatically from a connected bank via Plaid — kept
  // distinct from IMPORT_BANK because match confidence differs: a bank's own
  // transaction descriptor rarely carries a tenant's name the way a manually
  // exported statement row does (see src/lib/lease-matching.ts).
}

// Set by the reconciliation engine only — never directly editable in a form.
// See src/lib/reconciliation.ts for the exact rules.
enum PaymentReconciliationStatus {
  UNMATCHED // no lease could be associated with this payment
  MATCHED // cleanly applied; its period is fully covered and on time
  SHORT // applied to a period whose combined payments don't cover the charge
  LATE // completed its period's coverage, but after the due date + grace
}

enum ImportBatchStatus {
  DRAFT // uploaded and parsed, awaiting column-mapping/lease-match review
  CONFIRMED // rows became real Payment records
}

enum ExpenseCategory {
  REPAIRS_MAINTENANCE
  UTILITIES
  INSURANCE
  TAXES
  MANAGEMENT_FEES
  MORTGAGE
  OTHER
}

enum MaintenanceStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

enum MaintenancePriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum NotificationType {
  RENT_DUE
  RENT_RECEIVED
  RENT_LATE
  MAINTENANCE_CREATED
  MAINTENANCE_UPDATED
  STAFF_INVITE
  TENANT_INVITE
  PASSWORD_RESET
  APPLICATION_RECEIVED
  APPLICATION_DECIDED
  LEASE_READY_TO_SIGN
  LEASE_SIGNED
}

enum ApplicationStatus {
  SUBMITTED // just came in, nobody's looked at it yet
  UNDER_REVIEW // staff has opened it and is actively working it
  APPROVED
  DENIED
  WITHDRAWN // applicant pulled out, or staff closed it as no longer relevant
}

enum LeaseDocumentStatus {
  DRAFT // being assembled by staff, not yet visible to the tenant
  SENT // staff has countersigned and it's waiting on the tenant
  SIGNED // every required signer has signed
  VOIDED // staff cancelled it before it was fully signed
}

enum LeaseSignerRole {
  LANDLORD // countersigned by staff when the document is sent
  TENANT
}

enum ListingStatus {
  DRAFT // being prepared, not yet something to advertise
  ACTIVE // currently being marketed
  ARCHIVED // unit got leased, or the listing was pulled
}

// The external sites a listing can be advertised on. See the comment on
// ListingPlatformConnection for why none of these are actually wired up to a
// real API yet.
enum SyndicationPlatform {
  ZILLOW
  REALTOR_COM
  ZUMPER
  APARTMENTS_COM
}

enum ListingSyndicationStatus {
  NOT_POSTED
  POSTED
  NEEDS_REFRESH // posted once, but the listing has since changed (price, availability, etc.)
}

enum NotificationStatus {
  SENT
  FAILED
  LOGGED // no email transport configured; recorded for the dev outbox
}

// ---------------------------------------------------------------------------
// Tenancy root
// ---------------------------------------------------------------------------

model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Stripe Connect (destination charges). We never touch funds ourselves.
  stripeAccountId      String?
  stripeChargesEnabled Boolean @default(false)
  stripePayoutsEnabled Boolean @default(false)

  // Org-wide rent policy defaults, overridable per lease.
  graceDays    Int @default(5)
  lateFeeCents Int @default(5000)

  users               User[]
  properties          Property[]
  tenants             Tenant[]
  leases              Lease[]
  invitations         Invitation[]
  maintenanceRequests MaintenanceRequest[]
  notifications       NotificationLog[]
  payments            Payment[]
  importBatches       PaymentImportBatch[]
  expenses            Expense[]
  bankConnection      BankConnection?
  applications        Application[]
  leaseTemplates      LeaseTemplate[]
  leaseDocuments      LeaseDocument[]
  listings            Listing[]
  listingConnections  ListingPlatformConnection[]
  vendors             Vendor[]
}

/**
 * One connected receiving bank account per organization, via Plaid. Mirrors
 * how Stripe Connect works on Organization above — one external financial
 * account, admin-managed — but this one is read-only (Plaid's Transactions
 * product, not a payment rail) and its credential is materially more
 * sensitive: `accessTokenEncrypted` grants ongoing read access to the org's
 * actual bank transaction history for as long as the connection stays
 * active, not a single charge. Never store it unencrypted — see
 * src/lib/plaid.ts for the encrypt/decrypt helpers and src/lib/db.ts's
 * neighboring comments for why nothing here can assume a live network
 * connection at module-evaluation time.
 */
model BankConnection {
  id             String       @id @default(cuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  plaidItemId          String @unique
  accessTokenEncrypted String

  institutionName String?
  institutionLogo String? // Plaid returns this as a base64 data URI; small enough to inline

  // Cursor for /transactions/sync — Plaid's own pagination token, not ours.
  // Null until the first sync completes.
  cursor String?

  status       BankConnectionStatus @default(ACTIVE)
  lastSyncedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

enum BankConnectionStatus {
  ACTIVE
  LOGIN_REQUIRED // Plaid's ITEM_LOGIN_REQUIRED webhook — the owner needs to
  // re-authenticate with their bank through Link before syncing can resume.
  REVOKED // owner disconnected, or Plaid reported the Item as permanently gone
}

model User {
  id             String        @id @default(cuid())
  email          String        @unique
  name           String
  passwordHash   String
  role           Role
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  lastLoginAt    DateTime?

  tenant               Tenant?
  ownedProperties      PropertyOwner[]
  maintenanceNotes     MaintenanceNote[]
  requestsCreated      MaintenanceRequest[] @relation("MaintenanceRequestCreatedBy")
  importBatches        PaymentImportBatch[]
  passwordResets       PasswordResetToken[]
  applicationsReviewed Application[]
  leaseDocumentsSent   LeaseDocument[]
  listingsCreated      Listing[]

  @@index([organizationId])
}

/**
 * A single-use password reset link.
 * Stores the SHA-256 of the token, never the token itself. The value in the
 * emailed link is the only copy, so a leaked database snapshot can't be turned
 * into account access — which is not true of Invitation.token above, and is the
 * reason this model doesn't just reuse that pattern.
 */
model PasswordResetToken {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /**
   * SHA-256 hex of the token. Unique so a lookup is a single indexed read.
   */
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Invitation {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  name           String
  role           Role
  token          String       @unique
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime     @default(now())

  // Set when inviting an existing Tenant record to the portal.
  tenantId String? @unique
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
}

// ---------------------------------------------------------------------------
// Portfolio
// ---------------------------------------------------------------------------

model Property {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  addressLine1   String
  addressLine2   String?
  city           String
  state          String
  postalCode     String
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  units    Unit[]
  owners   PropertyOwner[]
  expenses Expense[]

  @@index([organizationId])
}

// Join table so an OWNER user can be granted read-only access to specific
// properties without seeing the rest of the portfolio.
model PropertyOwner {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([propertyId, userId])
  @@index([userId])
}

model Unit {
  id              String     @id @default(cuid())
  propertyId      String
  property        Property   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  label           String // "2B", "Unit 4", "House"
  bedrooms        Int        @default(1)
  bathrooms       Float      @default(1)
  sqft            Int?
  marketRentCents Int        @default(0)
  status          UnitStatus @default(VACANT)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  leases              Lease[]
  maintenanceRequests MaintenanceRequest[]
  applications        Application[]
  listings            Listing[]

  @@unique([propertyId, label])
  @@index([propertyId])
}

// ---------------------------------------------------------------------------
// People & leases
// ---------------------------------------------------------------------------

model Tenant {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  firstName      String
  lastName       String
  email          String
  phone          String?
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // Populated once the tenant accepts a portal invitation.
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  leases     Lease[]
  invitation Invitation?

  @@unique([organizationId, email])
  @@index([organizationId])
}

model Lease {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  unitId         String
  unit           Unit         @relation(fields: [unitId], references: [id], onDelete: Cascade)
  tenantId       String
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  status          LeaseStatus @default(ACTIVE)
  startDate       DateTime
  endDate         DateTime?
  rentAmountCents Int
  depositCents    Int         @default(0)
  rentDueDay      Int         @default(1) // day of month rent is due, 1-28
  notes           String?

  // Subsidized (e.g. Section 8/HAP) arrangements. Null subsidyOwedCents means
  // "no split" — the whole rentAmountCents is owed by the tenant, as today.
  // When set, the tenant-owed portion is *derived* (rentAmountCents -
  // subsidyOwedCents) rather than stored separately, so the two figures can
  // never drift out of sync after a rent change. See src/lib/rent-split.ts.
  subsidyOwedCents Int?
  subsidyPayerName String? // e.g. "Springfield Housing Authority" — free text

  // Renter's insurance — tracked, not enforced. Nothing in this app blocks
  // move-in or charges a fee for missing coverage; this is a record-keeping
  // and reminder surface only, matching what a small landlord actually wants
  // (know who's covered, get nudged before a policy lapses), not a compliance
  // gate. insuranceRequired is a per-lease toggle because not every landlord
  // requires it and not every unit type needs it (e.g. an owner-occupied duplex).
  insuranceRequired     Boolean   @default(false)
  insuranceProvider     String?
  insurancePolicyNumber String?
  insuranceExpiresAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  charges             Charge[]
  payments            Payment[]
  maintenanceRequests MaintenanceRequest[]
  // Set on the Application this lease was created from, when it was created
  // that way — see Application.leaseId below.
  application         Application?
  documents           LeaseDocument[]

  @@index([organizationId])
  @@index([unitId])
  @@index([tenantId])
}

// ---------------------------------------------------------------------------
// Ledger: what is owed (Charge) vs. what came in (Payment)
// ---------------------------------------------------------------------------

model Charge {
  id          String     @id @default(cuid())
  leaseId     String
  lease       Lease      @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  type        ChargeType @default(RENT)
  amountCents Int
  dueDate     DateTime
  description String
  // For RENT charges: the first day of the month the charge covers. Used as an
  // idempotency key so a rent run can never double-bill a period.
  periodStart DateTime?
  voidedAt    DateTime?
  createdAt   DateTime   @default(now())

  payments Payment[]

  @@unique([leaseId, type, periodStart])
  @@index([leaseId])
  @@index([dueDate])
}

model Payment {
  id             String       @id @default(cuid())
  // Direct org scope, independent of leaseId: an imported payment that can't
  // be matched to any lease (UNMATCHED) still has to live inside its
  // organization's boundary, so this can't be derived through the lease.
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Null until the reconciliation engine (or a human, during import review)
  // assigns it. A payment with no lease is always UNMATCHED.
  leaseId     String?
  lease       Lease?         @relation(fields: [leaseId], references: [id], onDelete: SetNull)
  chargeId    String?
  charge      Charge?        @relation(fields: [chargeId], references: [id], onDelete: SetNull)
  amountCents Int
  status      PaymentStatus  @default(PENDING)
  method      PaymentMethod?
  memo        String?

  source               PaymentSource               @default(MANUAL_CASH)
  reconciliationStatus PaymentReconciliationStatus @default(UNMATCHED)
  // As captured from an import row or typed at manual entry — kept verbatim
  // for audit even after a lease match is made or changed.
  payerNameRaw         String?
  // Transaction id / reference from the source file or provider, when one
  // exists. Not unique on its own (see PaymentImportBatch's content-hash
  // dedup for the real duplicate-import guard).
  externalRef          String?

  importBatchId String?
  importBatch   PaymentImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)

  stripeCheckoutSessionId String? @unique
  stripePaymentIntentId   String? @unique

  paidAt         DateTime?
  failedAt       DateTime?
  failureMessage String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([organizationId])
  @@index([leaseId])
  @@index([status])
  @@index([organizationId, reconciliationStatus])
  @@index([importBatchId])
}

// One CSV/statement upload. Kept as its own row (rather than just tagging
// Payments with a source) so imports have a review step, an audit trail, and
// a way to stop the same file being imported twice.
model PaymentImportBatch {
  id             String            @id @default(cuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  source         PaymentSource
  status         ImportBatchStatus @default(DRAFT)
  filename       String
  uploadedById   String?
  uploadedBy     User?             @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  // The parsed file, kept for the review screen and for audit ("view
  // original") after confirmation. Bank/Venmo/CashApp/HAP exports are small
  // (hundreds of rows at most) so storing the text in the database is simple
  // and avoids standing up object storage for what's fundamentally a rare,
  // small-file workflow — revisit if imports grow to needing streaming.
  rawCsv        String
  // { dateColumn, amountColumn, descriptionColumn, payerColumn, refColumn }
  columnMapping Json
  rowCount      Int
  // SHA-256 of the raw file bytes. Uploading the identical file twice is the
  // single most common accidental-double-import mistake; this blocks it
  // outright rather than relying on per-row heuristics.
  contentHash   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments Payment[]

  @@unique([organizationId, contentHash])
  @@index([organizationId, createdAt])
}

// ---------------------------------------------------------------------------
// Maintenance
// ---------------------------------------------------------------------------

model MaintenanceRequest {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  unitId          String
  unit            Unit         @relation(fields: [unitId], references: [id], onDelete: Cascade)
  leaseId         String?
  lease           Lease?       @relation(fields: [leaseId], references: [id], onDelete: SetNull)
  createdByUserId String?
  createdBy       User?        @relation("MaintenanceRequestCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  // Optional and org-scoped, not tenant-facing (see Vendor below) — assigning
  // or clearing this never touches the tenant portal.
  assignedVendorId String?
  assignedVendor   Vendor?      @relation(fields: [assignedVendorId], references: [id], onDelete: SetNull)

  title       String
  description String
  status      MaintenanceStatus   @default(OPEN)
  priority    MaintenancePriority @default(NORMAL)
  resolvedAt  DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  photos MaintenancePhoto[]
  notes  MaintenanceNote[]

  @@index([organizationId, status])
  @@index([unitId])
  @@index([assignedVendorId])
}

// A landlord's own directory of contractors/vendors — not a marketplace, not
// tied to any listing-platform integration, just who to call. `active` is a
// soft-delete: archiving a vendor keeps their name attached to every past
// MaintenanceRequest.assignedVendor (onDelete: SetNull above would otherwise
// erase "who fixed this" from history the moment a vendor is retired).
model Vendor {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name        String
  // Free text on purpose — "Plumbing", "HVAC", "Locksmith", whatever the
  // landlord actually calls it. A fixed enum would just fight real vendors
  // who cover more than one trade.
  trade       String?
  contactName String?
  email       String?
  phone       String?
  notes       String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  requests MaintenanceRequest[]

  @@index([organizationId, active])
}

// Photos live in the database as bytes. This keeps the MVP deployable with nothing
// but a database — no S3 bucket, no signed URLs, no extra vendor. Uploads are
// capped (see src/lib/constants.ts); swap for object storage when volume grows.
model MaintenancePhoto {
  id          String             @id @default(cuid())
  requestId   String
  request     MaintenanceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  filename    String
  contentType String
  sizeBytes   Int
  data        Bytes
  createdAt   DateTime           @default(now())

  @@index([requestId])
}

model MaintenanceNote {
  id        String             @id @default(cuid())
  requestId String
  request   MaintenanceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?              @relation(fields: [authorId], references: [id], onDelete: SetNull)
  body      String
  // Internal notes are hidden from the tenant portal.
  internal  Boolean            @default(false)
  createdAt DateTime           @default(now())

  @@index([requestId])
}

// ---------------------------------------------------------------------------
// Rental applications
//
// A prospect applies against a specific unit via a public, unauthenticated
// link (/apply/[unitId] — the unit's cuid doubles as the unlisted-but-shareable
// token, the same trust model an Innago-style "listing link" uses). Staff then
// reviews it from inside the app and, if approved, converts it into a lease.
// There is deliberately no separate "Prospect" or account for the applicant —
// this is a single-shot record, not a portal login.
// ---------------------------------------------------------------------------

model Application {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  unitId         String
  unit           Unit         @relation(fields: [unitId], references: [id], onDelete: Cascade)

  firstName String
  lastName  String
  email     String
  phone     String?

  desiredMoveInDate  DateTime?
  occupants          Int?
  // What the applicant told us they make a month — a self-reported figure for
  // staff to weigh, never verified by this app. See src/lib/applications.ts
  // for the income-guideline calculation this feeds.
  monthlyIncomeCents Int?
  hasPets            Boolean   @default(false)
  petDetails         String?
  message            String?

  status ApplicationStatus @default(SUBMITTED)

  // Staff-only; never shown to the applicant.
  reviewNotes  String?
  reviewedById String?
  reviewedBy   User?     @relation(fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?

  // Set once staff creates a lease from this application (see
  // convertApplicationToLeaseAction), so the audit trail shows what an
  // approved application actually turned into. Unique because a lease can only
  // ever have come from one application.
  leaseId String? @unique
  lease   Lease?  @relation(fields: [leaseId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, status])
  @@index([unitId])
}

// ---------------------------------------------------------------------------
// Lease documents & e-signature
//
// LeaseTemplate is the org's reusable base wording — one standard template per
// org today (see src/lib/lease-document.ts for how it's lazily created), with
// {{token}} merge fields and [[#clauseId]]...[[/clauseId]] optional blocks
// staff can toggle per document. LeaseDocument is an immutable *snapshot*:
// once merged, its body never changes even if the template is edited later,
// so a document a tenant already signed can't silently drift out from under
// their signature. LeaseSignature is the audit trail an electronic signature
// needs under the U.S. ESIGN Act — who signed, what they typed/drew, and the
// IP/user-agent/timestamp it happened under — not a real-time signing
// session. See docs/lease-signing.md.
// ---------------------------------------------------------------------------

model LeaseTemplate {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  // Plain text, never HTML — merged bodies are rendered with
  // white-space:pre-wrap, so no markup layer is needed and there's nothing
  // here that ever needs sanitizing before it's shown.
  body           String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  documents LeaseDocument[]

  @@index([organizationId])
}

model LeaseDocument {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leaseId        String
  lease          Lease          @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  templateId     String?
  template       LeaseTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  title  String
  // The fully merged document text at generation time — see the section
  // comment above on why this is a snapshot, not a live re-render.
  body   String
  status LeaseDocumentStatus @default(DRAFT)

  createdById String?
  createdBy   User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  sentAt      DateTime?
  completedAt DateTime?
  voidedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  signatures LeaseSignature[]

  @@index([organizationId])
  @@index([leaseId])
}

model LeaseSignature {
  id         String          @id @default(cuid())
  documentId String
  document   LeaseDocument   @relation(fields: [documentId], references: [id], onDelete: Cascade)
  role       LeaseSignerRole

  signerName  String
  signerEmail String

  // Null until signed — a document is created with placeholder rows for each
  // required signer (see sendLeaseDocumentAction) so "who still needs to
  // sign" is always a query over this table, not separately tracked state.
  signedAt       DateTime?
  typedSignature String?
  // A freehand signature drawn on-screen, as a PNG. Optional on top of the
  // typed name, not instead of it — the typed name plus this audit trail is
  // what makes the signature valid, not the drawing itself.
  signatureImage Bytes?
  ipAddress      String?
  userAgent      String?

  createdAt DateTime @default(now())

  @@index([documentId])
}

// ---------------------------------------------------------------------------
// Email audit trail (also powers the dev outbox at /app/settings/outbox)
// ---------------------------------------------------------------------------

model NotificationLog {
  id             String             @id @default(cuid())
  organizationId String?
  organization   Organization?      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  type           NotificationType
  status         NotificationStatus
  toEmail        String
  subject        String
  body           String
  error          String?
  // Idempotency key so a repeated rent run doesn't re-send the same reminder.
  dedupeKey      String?            @unique
  createdAt      DateTime           @default(now())

  @@index([organizationId, createdAt])
}

// ---------------------------------------------------------------------------
// Expenses — the other half of a per-property P&L. Deliberately minimal
// (no vendor/bill workflow, no recurring rules): a landlord logs what they
// spent, when, and on which property. See src/lib/reports.ts.
// ---------------------------------------------------------------------------

model Expense {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  propertyId     String
  property       Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  category       ExpenseCategory @default(OTHER)
  amountCents    Int
  date           DateTime
  description    String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([organizationId])
  @@index([propertyId, date])
}

// ---------------------------------------------------------------------------
// Listings — advertising a vacant unit to find its next tenant.
//
// A Listing is per-unit marketing copy (description, photos, asking rent,
// availability), independent of Application (the intake form a prospect
// actually fills out) and Lease. ListingSyndication is a *manual* tracker —
// one row per platform per listing — for staff to record where a listing has
// actually been posted, because posting itself still happens by hand: see
// ListingPlatformConnection below and docs/listings.md for why there's no
// automated push to Zillow/Realtor.com/Zumper/Apartments.com yet.
// ---------------------------------------------------------------------------

model Listing {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  unitId         String
  unit           Unit         @relation(fields: [unitId], references: [id], onDelete: Cascade)

  title           String
  description     String
  // Free text, comma-separated ("In-unit laundry, Pet friendly, Off-street
  // parking") rather than a separate table — same "don't build a workflow
  // engine for a small landlord" call as Application.petDetails.
  amenities       String?
  askingRentCents Int
  availableDate   DateTime?
  status          ListingStatus @default(ACTIVE)

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  photos       ListingPhoto[]
  syndications ListingSyndication[]

  @@index([organizationId])
  @@index([unitId])
}

model ListingPhoto {
  id          String   @id @default(cuid())
  listingId   String
  listing     Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  filename    String
  contentType String
  sizeBytes   Int
  data        Bytes
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([listingId])
}

// One row per platform a listing could be advertised on, created alongside
// the Listing so the tracker always shows all four rows immediately (see
// createListingAction) rather than staff having to add each one by hand.
model ListingSyndication {
  id         String                   @id @default(cuid())
  listingId  String
  listing    Listing                  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  platform   SyndicationPlatform
  status     ListingSyndicationStatus @default(NOT_POSTED)
  // Staff paste the live URL in after posting by hand, so "view listing" is
  // one click from here — see the section comment above.
  listingUrl String?
  postedAt   DateTime?
  updatedAt  DateTime                 @updatedAt

  @@unique([listingId, platform])
  @@index([listingId])
}

/**
 * Org-level, one row per platform. Everything here is inert today — nothing
 * in this codebase reads apiKeyEncrypted or calls out to any of these
 * platforms. It exists so that if/when this organization is approved as a
 * listing-software partner by Zillow, Realtor.com, Zumper, or Apartments.com
 * (a real business application to each of them, not something this app can
 * self-serve — see docs/listings.md), the credential already has somewhere
 * to live and a future automated-push feature isn't also a migration.
 * accountLabel/notes are free text for staff's own reference only.
 */
model ListingPlatformConnection {
  id              String              @id @default(cuid())
  organizationId  String
  organization    Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  platform        SyndicationPlatform
  accountLabel    String?
  apiKeyEncrypted String?
  notes           String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@unique([organizationId, platform])
}
