DATABASE_URL="file:./dev.db"
AUTH_SECRET="dev-only-secret-change-me-1234567890abcdef"
AUTH_URL="http://localhost:3000"
APP_URL="http://localhost:3000"

# Optional — Stripe Connect (rent collection is fully manual without these)
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""
# STRIPE_APPLICATION_FEE_BPS="0"

# Optional — only needed to run /api/cron/rent-run
# CRON_SECRET=""

# Optional — outbound email. Leave both unset for local dev: every message is
# written to the in-app log at /app/settings/outbox instead of being sent, which
# is what you want while developing.
#
# EMAIL_FROM is the switch. Without it nothing is delivered by any provider,
# because every provider requires a verified sending domain — so it has to be an
# address on a domain you've onboarded to Cloudflare Email Service (see
# wrangler.jsonc's send_email binding). In production that's a Worker var, not a
# secret. RESEND_API_KEY is only for the Resend fallback; Cloudflare's binding
# needs no key at all, which is why it's the default path.
# EMAIL_FROM=""
# RESEND_API_KEY=""

# Optional — Plaid bank-feed connection for owners (without these, owners can
# still be tracked via manual CSV import — see docs/MAINTAINER.md)
# PLAID_CLIENT_ID=""
# PLAID_SECRET=""
# PLAID_ENV="sandbox"          # sandbox | production

# Optional — required to save a Plaid connection or a listing-platform API key
# (src/lib/token-encryption.ts encrypts both at rest). Without it, saving
# either just fails with a generic error rather than throwing at startup.
# BANK_TOKEN_ENCRYPTION_KEY=""  # openssl rand -base64 32

# Optional — live address suggestions on the property form (see
# docs/address-autocomplete.md). Without it the street-address field is a
# plain text input, nothing more. Get a free public token (pk.…) at
# https://account.mapbox.com/auth/signup/ — no credit card required, 100k
# free geocoding requests/month. This is a *public* token, meant to sit in
# client-side JS, unlike every other key on this page.
#
# Cloudflare deploys: Next.js inlines NEXT_PUBLIC_* vars at *build* time —
# set this as a Workers Builds "build variable" in the Cloudflare dashboard,
# not a wrangler.jsonc var (which the client bundle can't see).
# NEXT_PUBLIC_MAPBOX_TOKEN=""
