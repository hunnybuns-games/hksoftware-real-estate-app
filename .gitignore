node_modules/
.next/
out/
build/
dist/
.env
.env.local
.env*.local
*.log
.DS_Store
next-env.d.ts
.vercel
tsconfig.tsbuildinfo
coverage/

# Cloudflare — build output and local wrangler state. wrangler.jsonc,
# open-next.config.ts, cloudflare-env.d.ts, and src/worker/ are committed.
.open-next/
.wrangler/
.dev.vars

# Local SQLite dev database (D1's dialect) — created by `prisma migrate dev`
# / `db seed`, never committed.
prisma/dev.db
prisma/dev.db-journal

# Remembers the landlord10 demo's live Stripe Connect account id across
# reseeds — see the comment on SEED_STATE_FILE in seed-landlord10.ts.
prisma/.landlord10-seed-state.json

# Screenshots and scratch files the e2e suites write while running — debugging
# aids for whoever is watching a failure, not fixtures anything asserts against.
e2e/.artifacts/

# Superseded local copies of the e2e scripts — the real ones now live in e2e/.
# Kept ignored so an older checkout doesn't suddenly start tracking them.
.e2e-run.mjs
.e2e-reconciliation-run.mjs
.e2e-reports-run.mjs
.security-probe-run.mjs

# Local-dev document storage. On Workers these live in the DOCUMENTS R2
# bucket; `next dev` has no bindings, so src/lib/document-storage.ts writes
# them here instead. Never committed.
.local-documents/
