{
  "name": "hksoftware-real-estate-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:landlord10": "tsx prisma/seed-landlord10.ts",
    "db:reset": "prisma migrate reset --force",
    "test": "vitest run",
    "e2e": "npm run e2e:mvp && npm run e2e:reconciliation && npm run e2e:reports && npm run e2e:security && npm run e2e:password-reset && npm run e2e:theme && npm run e2e:applications && npm run e2e:lease-signing && npm run e2e:listings && npm run e2e:address-autocomplete && npm run e2e:vendors && npm run e2e:tenant-screening",
    "e2e:mvp": "node e2e/mvp.mjs",
    "e2e:reconciliation": "node e2e/reconciliation.mjs",
    "e2e:reports": "node e2e/reports.mjs",
    "e2e:security": "node e2e/security.mjs",
    "e2e:password-reset": "node e2e/password-reset.mjs",
    "e2e:theme": "node e2e/theme.mjs",
    "e2e:applications": "node e2e/applications.mjs",
    "e2e:lease-signing": "node e2e/lease-signing.mjs",
    "e2e:listings": "node e2e/listings.mjs",
    "e2e:address-autocomplete": "node e2e/address-autocomplete.mjs",
    "e2e:vendors": "node e2e/vendors.mjs",
    "e2e:tenant-screening": "node e2e/tenant-screening.mjs",
    "e2e:landlord10": "node e2e/landlord10-tour.mjs",
    "cf:build": "prisma generate && opennextjs-cloudflare build",
    "cf:preview": "npm run cf:build && opennextjs-cloudflare preview",
    "cf:deploy": "npm run cf:build && opennextjs-cloudflare deploy",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "cf:migrations:sync": "node scripts/sync-d1-migrations.mjs",
    "cf:migrations:check": "node scripts/sync-d1-migrations.mjs --check",
    "cf:migrate": "npm run cf:migrations:sync && wrangler d1 migrations apply hksoftware-real-estate-db --remote",
    "cf:migrate:local": "npm run cf:migrations:sync && wrangler d1 migrations apply hksoftware-real-estate-db --local",
    "cf:migrations:status": "wrangler d1 migrations list hksoftware-real-estate-db --remote"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-d1": "^6.19.3",
    "@prisma/client": "6.19.3",
    "bcryptjs": "^3.0.2",
    "clsx": "^2.1.1",
    "next": "16.2.12",
    "next-auth": "5.0.0-beta.32",
    "plaid": "^45.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-plaid-link": "^5.0.0",
    "stripe": "^22.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@prisma/adapter-better-sqlite3": "^6.19.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "better-sqlite3": "^13.0.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.0",
    "playwright": "^1.62.1",
    "prisma": "6.19.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.3",
    "typescript": "5.9.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.118.0"
  }
}
