{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hksoftware-real-estate-app",
  // Points at our thin wrapper (src/worker/index.ts), not the OpenNext
  // output directly — the wrapper adds the scheduled() handler for the
  // daily rent run below. Everything else passes straight through to the
  // generated Next.js worker. Run `npm run cf:build` before `wrangler deploy`
  // so both this file and .open-next/worker.js exist.
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-08-05",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Same job Vercel's cron used to hit over HTTP (see vercel.json in the
  // pre-Cloudflare setup) — now a native Cron Trigger. Time is UTC; this
  // matches vercel.json's "0 13 * * *".
  "triggers": {
    "crons": ["0 13 * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hksoftware-real-estate-db",
      // D1 is a native Workers binding (see src/lib/db.ts) — no connection
      // string, no network hop, no connection pool to manage or go stale.
      // This replaced an external Postgres+Hyperdrive setup; see
      // docs/MAINTAINER.md for why. The schema still needs to be applied to
      // this database (see docs/MAINTAINER.md §11/§14 — `wrangler d1
      // execute --remote --file=...`) before the app can actually run
      // against it.
      "database_id": "7b7e8815-d2f6-4de9-8948-b840936fadc4"
    }
  ],
  "vars": {
    // Tells src/lib/db.ts to use the D1 binding above instead of a local
    // SQLite file. Not a secret — just a switch, so it's safe to keep in
    // source. Left unset for local dev and for `prisma migrate`/`db seed`,
    // which always talk to a local SQLite file directly.
    "USE_D1": "true"
  }
  // Secrets (set with `npx wrangler secret put <NAME>`, never in this file):
  //   AUTH_SECRET, STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, CRON_SECRET,
  //   PLAID_CLIENT_ID, PLAID_SECRET, BANK_TOKEN_ENCRYPTION_KEY
  // Non-secret vars you likely also want to add above once deployed:
  //   AUTH_URL, APP_URL (your production origin), STRIPE_APPLICATION_FEE_BPS,
  //   PLAID_ENV ("production" once you're off Sandbox — defaults to "sandbox")
}
