{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hksoftware-real-estate-app",
  // Points at our thin wrapper (src/worker/index.ts), not the OpenNext
  // output directly — the wrapper adds the scheduled() handler for the
  // daily rent run below. Everything else passes straight through to the
  // generated Next.js worker. Run `npm run cf:build` before `wrangler deploy`
  // so both this file and .open-next/worker.js exist.
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-08-05",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Same job Vercel's cron used to hit over HTTP (see vercel.json in the
  // pre-Cloudflare setup) — now a native Cron Trigger. Time is UTC; this
  // matches vercel.json's "0 13 * * *".
  "triggers": {
    "crons": ["0 13 * * *"]
  },
  // Schema changes go through `npm run cf:migrate`, which runs
  // `wrangler d1 migrations apply` against the files in migrations/ — generated
  // from prisma/migrations by npm run cf:migrations:sync. Prisma is still what
  // you author with; that's just the flat layout Wrangler wants.
  //
  // Using Wrangler's migration command rather than pasting SQL into a console is
  // the point: it keeps a ledger of what's already been applied *in the database*,
  // which is exactly what was missing when a deployed page queried a table that
  // had never been created.
  //
  // No migrations_dir key here on purpose — "migrations" is already Wrangler's
  // default, and setting it explicitly is rejected as an unknown top-level field
  // by wrangler 4.118.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hksoftware-real-estate-db",
      // D1 is a native Workers binding (see src/lib/db.ts) — no connection
      // string, no network hop, no connection pool to manage or go stale.
      // This replaced an external Postgres+Hyperdrive setup; see
      // docs/MAINTAINER.md for why. The schema still needs to be applied to
      // this database (see docs/MAINTAINER.md §11/§14 — `wrangler d1
      // execute --remote --file=...`) before the app can actually run
      // against it.
      "database_id": "7b7e8815-d2f6-4de9-8948-b840936fadc4"
    }
  ],
  /**
   * Rate limiting for the two unauthenticated endpoints that are worth abusing.
   * A security review confirmed eight rapid wrong-password attempts hit no
   * throttle at all: bcrypt's cost slows an attacker but there is no lockout and
   * no signal that it's happening.
   *
   * Cloudflare's zone-level WAF rate limiting needs a domain in your own account,
   * which this deployment doesn't have yet (it's on workers.dev). This binding is
   * the runtime equivalent and needs no custom domain, so it's available now.
   *
   * `period` only accepts 10 or 60 (wrangler's own config schema enforces it).
   * namespace_id just has to be unique per limiter within the account.
   */
  "ratelimits": [
    {
      // Per-IP and per-email, checked separately — see src/lib/rate-limit.ts.
      // 10/minute is far above what a person typing a password does and far
      // below what a script needs to be useful.
      "name": "LOGIN_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      // Tighter: signup is how someone floods the database with junk orgs, and
      // nobody legitimately creates five accounts a minute.
      "name": "SIGNUP_RATE_LIMIT",
      "namespace_id": "1002",
      "simple": { "limit": 5, "period": 60 }
    }
  ],
  /**
   * Outbound email, through Cloudflare Email Service rather than a third-party
   * provider — one account, one bill, no API key to rotate. src/lib/email.ts
   * prefers this binding and falls back to Resend, then to the in-app email log.
   *
   * Deliberately unrestricted. The optional `destination_address` /
   * `allowed_destination_addresses` / `allowed_sender_addresses` attributes cap
   * who a binding may mail, and capping recipients is wrong here: the recipients
   * are tenants and owners, and we don't know them in advance.
   *
   * TWO THINGS GATE THIS AT RUNTIME, and until both are done the app quietly
   * falls back to the email log instead of breaking (see src/lib/email.ts):
   *
   *   1. A sending domain onboarded to Email Service, and EMAIL_FROM set to an
   *      address on it. Until then you can only send to *verified destination
   *      addresses* in the account — your own inbox, which is fine for testing
   *      but not for real residents. Errors as E_SENDER_DOMAIN_NOT_AVAILABLE.
   *   2. The Workers Paid plan. Sending to arbitrary recipients isn't available
   *      on Free at all; 3,000/month are included on Paid, then $0.35 per 1,000.
   *
   * Worth knowing before you go looking for a bug: mail sent through this binding
   * shows up as **dropped** in the Email Routing summary even when it was
   * delivered. Outbound sends are tracked under Email Sending metrics instead.
   */
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
  "vars": {
    // Tells src/lib/db.ts to use the D1 binding above instead of a local
    // SQLite file. Not a secret — just a switch, so it's safe to keep in
    // source. Left unset for local dev and for `prisma migrate`/`db seed`,
    // which always talk to a local SQLite file directly.
    "USE_D1": "true",

    // The origin the app uses to build any link it hands to the outside world:
    // invitation and notification emails (src/lib/email.ts appUrl()), Stripe's
    // success/cancel return URLs, and the webhook URL registered with Plaid.
    //
    // Without it, appUrl() falls back to http://localhost:3000 — which is not a
    // visible error, it's worse: invitation emails would carry unusable
    // localhost links, and Plaid would be told to deliver webhooks to
    // localhost, so a connected bank would simply never sync. Both would look
    // like they had worked.
    //
    // Belongs here rather than in the dashboard: Workers Builds deploys by
    // running `wrangler deploy`, which replaces the deployed vars with this
    // block, so a dashboard-only value gets wiped on the next push. Update this
    // line when you move to a custom domain.
    //
    // Deliberately no AUTH_URL: src/lib/auth.ts sets trustHost, so Auth.js
    // derives its own URLs from the incoming request. That's strictly better
    // here — it stays correct on workers.dev and on a custom domain without
    // anyone remembering to change a second setting.
    "APP_URL": "https://hksoftware-real-estate-app.hksoftware.workers.dev"
  }
  // Secrets (set with `npx wrangler secret put <NAME>`, never in this file):
  //   AUTH_SECRET, STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, CRON_SECRET,
  //   PLAID_CLIENT_ID, PLAID_SECRET, BANK_TOKEN_ENCRYPTION_KEY
  // Non-secret vars you likely also want to add above once deployed:
  //   AUTH_URL, APP_URL (your production origin), STRIPE_APPLICATION_FEE_BPS,
  //   PLAID_ENV ("production" once you're off Sandbox — defaults to "sandbox")
}
